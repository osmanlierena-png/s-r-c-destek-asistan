    },
    "name": {
      "type": "string",
      "description": "\u015eablonun okunabilir ad\u0131 (\u00f6rn: 60 Dakika Kontrol\u00fc)"
    },
    "description": {
      "type": "string",
      "description": "\u015eablonun a\u00e7\u0131klamas\u0131"
    },
