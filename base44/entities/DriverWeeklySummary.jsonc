{
  "name": "DriverWeeklySummary",
  "type": "object",
  "properties": {
    "driver_id": {
      "type": "string",
      "description": "S\u00fcr\u00fcc\u00fcn\u00fcn ID'si"
    },
    "driver_name": {
      "type": "string",
      "description": "S\u00fcr\u00fcc\u00fcn\u00fcn ad\u0131"
    },
    "week_start_date": {
      "type": "string",
      "format": "date",
      "description": "Haftan\u0131n ba\u015flang\u0131\u00e7 tarihi (Pazartesi)"
    },
    "week_end_date": {
      "type": "string",
      "format": "date",
      "description": "Haftan\u0131n biti\u015f tarihi (Pazar)"
    },
    "total_canvas_price": {
      "type": "number",
      "description": "Haftal\u0131k toplam canvas fiyat\u0131 (s\u00fcr\u00fcc\u00fc kazanc\u0131)"
    },
    "order_count": {
      "type": "number",
      "description": "Haftal\u0131k toplam sipari\u015f say\u0131s\u0131"
    },
    "status": {
      "type": "string",
      "enum": [
        "Hesapland\u0131",
        "Onayland\u0131",
        "\u00d6dendi"
      ],
      "default": "Hesapland\u0131",
      "description": "\u00d6deme durumu"
    },
    "paid_date": {
      "type": "string",
      "format": "date",
      "description": "\u00d6demenin yap\u0131ld\u0131\u011f\u0131 tarih"
    },
    "notes": {
      "type": "string",
      "description": "\u00d6deme ile ilgili notlar"
    }
  },
  "required": [
    "driver_id",
    "driver_name",
    "week_start_date",
    "week_end_date"
  ]
}